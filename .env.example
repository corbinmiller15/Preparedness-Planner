# Supabase. The placeholder page boots without these.
# Auth and database calls need both public values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Not read by this beta. Do not expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend. sendEmail skips the network when the API key is missing.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Gemini Flash, used only to reword text. rewordText skips the network without a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Hazard ratings. Unset or `fixture` keeps the sample ZIP list and sample ratings.
# `fema_nri` queries the public FEMA National Risk Index county layer (no API key)
# and resolves ZIPs with the Census ZCTA-county crosswalk.
# The crosswalk is committed at data/zip-county-crosswalk.json.
# Rebuild it with npm run data:zip-county. That script is not part of npm run build.
HAZARD_PROVIDER=fixture
# HAZARD_PROVIDER_TIMEOUT_MS=8000
# HAZARD_PROVIDER_CACHE_TTL_MS=86400000
